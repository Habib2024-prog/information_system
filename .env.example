POSTGRES_DB=government_system
POSTGRES_USER=government_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:5173
SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Local development uses this directory. On an office/LAN server, set an
# absolute persistent directory and PROFILE_IMAGE_LOCAL_PERSISTENT=true.
APP_ENVIRONMENT=development
PROFILE_IMAGE_STORAGE_BACKEND=local
PROFILE_IMAGE_LOCAL_DIRECTORY=backend/uploads/profile-images
PROFILE_IMAGE_LOCAL_PERSISTENT=false
# Render must use persistent S3-compatible object storage, not local uploads.
# PROFILE_IMAGE_STORAGE_BACKEND=s3
# PROFILE_IMAGE_S3_BUCKET=your-bucket
# PROFILE_IMAGE_S3_REGION=your-region
# PROFILE_IMAGE_S3_ENDPOINT_URL=https://s3-compatible-endpoint
# PROFILE_IMAGE_S3_PUBLIC_BASE_URL=https://cdn-or-public-bucket-url
# PROFILE_IMAGE_S3_PREFIX=profile-images
